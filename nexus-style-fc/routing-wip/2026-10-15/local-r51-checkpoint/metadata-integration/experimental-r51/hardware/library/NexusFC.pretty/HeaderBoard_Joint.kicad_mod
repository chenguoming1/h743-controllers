(footprint "HeaderBoard_Joint"
  (version 20240108) (generator "nexus-style-fc") (layer "F.Cu")
  (descr "Servo-header child board joint (VBar style): 2 long NPTH slots (bar-gap-bar); all solder on the bottom face: inner slot edge one pad per net, outer slot edge one long strip per slot (VX left, GND right). Courtyard = no-parts band on both sides. Origin = main PCB top-left corner")
  (attr through_hole)
  (fp_text reference "REF**" (at 11.2 4.70) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.08))))
  (fp_text value "HeaderBoard" (at 11.2 5.50) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.08))))
  (fp_rect (start 0 1.60) (end 22.4 3.20) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_rect (start 0.05 0.1) (end 22.349999999999998 5.00) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_rect (start 0.05 0.1) (end 22.349999999999998 5.00) (stroke (width 0.05) (type solid)) (fill none) (layer "B.CrtYd"))
  (fp_text user "no parts in this band (top and bottom)" (at 11.2 4.70) (layer "B.Fab") (effects (font (size 0.45 0.45) (thickness 0.07)) (justify mirror)))
  (pad "" np_thru_hole oval (at 5.600 2.400) (size 10.400 1.800) (drill oval 10.400 1.800) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole oval (at 16.800 2.400) (size 10.400 1.800) (drill oval 10.400 1.800) (layers "*.Cu" "*.Mask"))
  (pad "3" smd rect (at 1.300 4.150) (size 1.2 1.00) (layers "B.Cu" "B.Mask"))
  (pad "4" smd rect (at 3.350 4.150) (size 1.2 1.00) (layers "B.Cu" "B.Mask"))
  (pad "5" smd rect (at 5.400 4.150) (size 1.2 1.00) (layers "B.Cu" "B.Mask"))
  (pad "6" smd rect (at 7.450 4.150) (size 1.2 1.00) (layers "B.Cu" "B.Mask"))
  (pad "1" smd rect (at 9.700 4.150) (size 1.6 1.00) (layers "B.Cu" "B.Mask"))
  (pad "2" smd rect (at 12.700 4.150) (size 1.6 1.00) (layers "B.Cu" "B.Mask"))
  (pad "7" smd rect (at 15.633 4.150) (size 1.2 1.00) (layers "B.Cu" "B.Mask"))
  (pad "8" smd rect (at 18.367 4.150) (size 1.2 1.00) (layers "B.Cu" "B.Mask"))
  (pad "9" smd rect (at 21.100 4.150) (size 1.2 1.00) (layers "B.Cu" "B.Mask"))
  (pad "1" smd rect (at 5.600 0.750) (size 9.800 0.80) (layers "B.Cu" "B.Mask"))
  (pad "2" smd rect (at 16.800 0.750) (size 9.800 0.80) (layers "B.Cu" "B.Mask"))
  (model "${KIPRJMOD}/library/NexusFC.3dshapes/nexus-header-board.wrl"
    (offset (xyz 22.4 -2.40 0)) (scale (xyz 1 1 1)) (rotate (xyz -90 0 180)))
)
