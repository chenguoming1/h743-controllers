    "datasheet_sections": [
      "Pin Functions: VAUX pin3 and GND pin4",
      "11.1 Layout Guidelines"
    ],
    "datasheet_layout_intent": "Keep supply loops short and wide; preserve separate local control/power ground routing and join near the IC ground. No stability approval is inferred from DC connectivity."
