 def object_sha(data):
     return hashlib.sha256(json.dumps(data,sort_keys=True,separators=(',',':'),allow_nan=False).encode()).hexdigest()
+
+def runtime_source(name):
+    local=HERE/'runtime'/name
+    return local if local.is_file() else SHARED/'runtime'/name
+
+def portable_ledger():
+    binding=load(HERE/'ledger-binding.json')
+    require(binding['replace_only_JSON_pointer']=='/freeze_manifest_sha256','Unexpected ledger edit')
+    base=HERE/binding['base_path']
+    require(sha(base)==binding['base_sha256'],'Shared historical ledger changed')
+    ledger=load(base)
+    ledger['freeze_manifest_sha256']=binding['replacement_value']
+    body=(json.dumps(ledger,indent=2,allow_nan=False)+'\n').encode()
+    require(hashlib.sha256(body).hexdigest()==binding['portable_ledger_serialized_sha256'],'Virtual ledger identity differs')
+    return ledger
+
+def materialize_runtime(out):
+    target=out/'runtime';target.mkdir(exist_ok=True)
+    for name,expected in load(HERE/'freeze.json')['analysis_source_sha256'].items():
+        source=runtime_source(name);require(sha(source)==expected,'Runtime source changed')
+        path=target/name
+        if not path.exists():
+            with path.open('xb') as stream:stream.write(source.read_bytes())
+        require(sha(path)==expected,'Materialized runtime changed')
+    sys.path.insert(0,str(target))
 
