(symbol (lib_id "Controller:Side_Socket_4") (at 83.82000000000001 184.15 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid b072a1e9-e613-5d61-ab36-6fa4d82e66b7)(property "Reference" "J5" (at 83.82000000000001 174.8 0) (effects (font (size 1.016 1.016)) ))(property "Value" "GPS / UART4" (at 83.82000000000001 176.8 0) (effects (font (size 1.016 1.016)) ))(property "Footprint" "H743_Board:J5_JST_SH_SM04B-SRSS-TB_1x04-1MP_P1.00mm_Horizontal" (at 83.82000000000001 184.15 0) (effects (font (size 1.016 1.016)) (hide yes)))(property "Datasheet" "" (at 83.82000000000001 184.15 0) (effects (font (size 1.016 1.016)) (hide yes)))(property "Manufacturer_Part_Number" "SM04B-SRSS-TB(LF)(SN)" (at 83.82000000000001 184.15 0) (effects (font (size 1.016 1.016)) (hide yes)))(property "LCSC" "C160404" (at 83.82000000000001 184.15 0) (effects (font (size 1.016 1.016)) (hide yes)))(pin "1" (uuid 5c2a0bf7-254c-44d4-92fe-cc2da0c1539f))(pin "2" (uuid a5a609bd-6b48-43d7-8e8f-ff3649702cb0))(pin "3" (uuid c7a1b85c-4baf-456f-a561-61a854560c5f))(pin "4" (uuid 6ab180e8-a68c-427f-8cec-52eb1919274f))(pin "MP" (uuid 8bd4aa29-db2c-49a9-8a97-62eb59f440ee))(instances (project "controller" (path "/b099c946-064a-48d3-853f-053cd104a6e7/6fffe428-cb00-581c-b4dd-7fb317552de8" (reference "J5") (unit 1)))) )
(text "J3 MOTOR:Lian Xin6, rearwest; custom pinout" (at 15 32 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid be03754e-96ba-48b2-a0a4-cf967b76485b))
(text "1 5V_STACK input /2GND /3hostTX /4motorTX /5RUN /6MOTOR_OK.\nDuplicates existing link after damping and before receive buffer.\nUse socket OR pads for one endpoint. Anchors are not extra cable returns.\nMotor board needs protected inputs and default-off independent gate.\nJ3 carries total controller+GPS supply current; no1A per-port allocation." (at 15 107 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid 37a79af6-fe52-49a0-9789-8c5c56bc3254))
(text "J4 EXTERNALSPI SENSOR:JST8, rearwest" (at 213 32 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid 74c063e7-3c01-4e35-ae07-04524255c508))
(text "1 3V3 /2GND /3SCK /4MOSI /5MISO /6CS /7IRQ /8GND.\nDuplicatesSPI3 andPC13 IRQ pads. Not an independent sensor bus.\nOne selectedCS/IRQ owner; do not parallel push-pull outputs.\nShort cable,3.3V, no off-state drive. No qualified spare power allowance.\nExternal sensor driver/clock/damping require target and bench tests." (at 213 125 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid ac5fc952-7d90-4d81-ac56-9db6a60cbd0d))
(text "J5 GPS UART4:JST4, reareast" (at 15 159 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid 4d7b2edf-4bf9-42dd-b7a7-0cd6a54e8d06))
(text "1 5V_STACK output /2GND /3controllerTX /4controllerRX.\nTX goes to moduleRX and viceversa; signals3.3V.\nNo5V onUSB-only power; do not connect a competing supply.\nCompassI2C andPPS are not carried by this socket.\nVerify module cable pinout; no universalGPS plug compatibility." (at 15 221 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid b985014e-ea1b-4570-bb25-79aed9da965a))
(text "Friction retention; correct crimps and independent strain relief.\nJ3 usesZYA1001H mate; mated envelope/cross-mating unqualified.\nJ4/J5 plainSHR-08V-S/SHR-04V-S; use rated wire/contact combination.\n2.9mm headers;JST mated2.95mm. Plan4mm rear airgap plus opposite parts.\nUSBovermold/harness/stack checks remain. Power off before mating." (at 213 210 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid 9b22423d-a1ff-40b8-98b0-e81a091b366b)) (embedded_fonts no))
